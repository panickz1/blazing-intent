# Directus CMS. The site reads through the Public policy, so no token is needed
# unless you lock content down. DIRECTUS_TOKEN is sent on every request if set.
DIRECTUS_URL=http://localhost:8055
DIRECTUS_TOKEN=

# Optional: serve uploads from a CDN/bucket instead of Directus /assets.
# Files are addressed as <CDN_URL><filename_disk>, so include the trailing slash.
NEXT_PUBLIC_CDN_URL=

# Brand and URLs. Everything else about the brand lives in src/site.config.js
# and src/app/theme.css.
NEXT_PUBLIC_BRAND_NAME=Acme Casinos
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_LANGUAGE=en
NEXT_PUBLIC_CTA_URL=/casinos
NEXT_PUBLIC_COMMUNITY_URL=

# Analytics. GA loads only after the first interaction, only when consent was
# not declined, and only on the hosts listed here (comma-separated).
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_PRODUCTION_HOSTS=

# Contact form. Leads are stored in the Directus "leads" collection. Set
# LEAD_STORE_IN_CMS=false to turn that off, and LEAD_WEBHOOK_URL to also POST
# every submission as JSON (with LEAD_WEBHOOK_SECRET in x-webhook-secret).
LEAD_STORE_IN_CMS=true
LEAD_WEBHOOK_URL=
LEAD_WEBHOOK_SECRET=

# On-demand revalidation. The Directus flow sends this in x-revalidate-secret.
# Generate with: openssl rand -base64 32
REVALIDATE_SECRET=

# schema.org Organization. Blank fields are left out of the JSON-LD.
SITE_LOGO_URL=
SITE_LOGO_WIDTH=
SITE_LOGO_HEIGHT=
ORG_LEGAL_NAME=
ORG_FOUNDING_DATE=
ORG_FOUNDER_NAME=
ORG_FOUNDER_URL=
ORG_VAT_ID=
ORG_ADDRESS_STREET=
ORG_ADDRESS_LOCALITY=
ORG_ADDRESS_REGION=
ORG_ADDRESS_POSTAL_CODE=
ORG_ADDRESS_COUNTRY=
ORG_CONTACT_EMAIL=
ORG_SAME_AS=

# Footer "Optimized by" credit. Both must be set for it to render.
OPTIMIZED_BY_NAME=
OPTIMIZED_BY_URL=

# Build into another folder while a dev server is running.
NEXT_DIST_DIR=
