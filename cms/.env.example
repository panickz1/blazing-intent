HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055

# Generate both: uuidgen, and openssl rand -hex 32
KEY=
SECRET=

DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=

# First admin, created by `yarn bootstrap`. Also used by `yarn setup` to log in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

CORS_ENABLED=true
CORS_ORIGIN=true

# Optional: create the "Revalidate website" flow during `yarn setup`.
# REVALIDATE_URL is the website's /api/revalidate endpoint, and the secret must
# match REVALIDATE_SECRET in the website's environment.
REVALIDATE_URL=
REVALIDATE_SECRET=

# Local only: Directus refuses flow requests to localhost by default. Uncomment
# so the revalidation flow can reach http://localhost:3000. Never set this in production.
# IMPORT_IP_DENY_LIST=169.254.169.254
