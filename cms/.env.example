HOST=0.0.0.0
PORT=8055
PUBLIC_URL=http://localhost:8055

# Generate both: uuidgen, and openssl rand -hex 32
KEY=
SECRET=

DB_CLIENT=pg
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=directus
DB_USER=directus
DB_PASSWORD=

# First admin, created by `yarn bootstrap`. Also used by `yarn setup` to log in.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=

CORS_ENABLED=true
CORS_ORIGIN=true

# Optional: create the "Revalidate website" flow during `yarn setup`.
# REVALIDATE_URL is the website's /api/revalidate endpoint, and the secret must
# match REVALIDATE_SECRET in the website's environment.
REVALIDATE_URL=
REVALIDATE_SECRET=

# Local only: Directus refuses flow requests to localhost by default. Uncomment
# so the revalidation flow can reach http://localhost:3000. Never set this in production.
# IMPORT_IP_DENY_LIST=169.254.169.254

# Optional: store uploads in an S3-compatible bucket instead of ./uploads.
# On Railway, add a Bucket and reference its variables (replace "Bucket" with
# the bucket's service name). Buckets are private: Directus serves the files at
# /assets, so leave NEXT_PUBLIC_CDN_URL empty on the website.
# STORAGE_LOCATIONS=s3
# STORAGE_S3_DRIVER=s3
# STORAGE_S3_KEY=${{Bucket.ACCESS_KEY_ID}}
# STORAGE_S3_SECRET=${{Bucket.SECRET_ACCESS_KEY}}
# STORAGE_S3_BUCKET=${{Bucket.BUCKET}}
# STORAGE_S3_REGION=${{Bucket.REGION}}
# STORAGE_S3_ENDPOINT=${{Bucket.ENDPOINT}}
# STORAGE_S3_FORCE_PATH_STYLE=false
